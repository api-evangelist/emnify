        {
          "id": "6b09ab33-361b-4602-b027-d2add1f09d9d",
          "name": "Resend user activation email",
          "request": {
            "name": "Resend user activation email",
            "description": {
              "content": "Re-sends activation mail to the user.\n\nAs this endpoint is open to the public (no authentication token necessary), it requires instead the google reCAPTCHA token to ensure that no robot is performing the request.\nMoreover, there's a time limit on how often a given user may be issued with a new activation mail.\n\n<Info>\n  According to the [reCAPTCHA documentation](https://developers.google.com/recaptcha/docs/display) a \"Site Key\" is necessary.\n  If you want to implement this feature in your client, please contact emnify support to obtain this \"Site Key\" for your domain.\n</Info>\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "user",
                "activation_resend"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
