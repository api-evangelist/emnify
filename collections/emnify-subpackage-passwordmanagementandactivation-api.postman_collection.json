        {
          "id": "5ff201d4-4e52-4ab5-b410-78a42302750d",
          "name": "Invite a user",
          "request": {
            "name": "Invite a user",
            "description": {
              "content": "Invite a user to a Workspace by specifying username and the roles that the user will have in the organization.\nThis user is created and a `User invited` event is sent.\nThere is no additional action such as an email sent.\n\nThe following fields may be provided:\n- `username` (String) - Email of the invited user\n- `name` (String) - Name of the invited user\n- `organisation` (Object) - Defaults to the default Workspace of the requesting user\n- `roles` (Array) - Assigns the **Administrator** role by default\n\nIf the invited user doesn't exist, a new user is created and the `organisation.id` is their default Workspace.\nIf the invited user already exists, the user is assigned to the Workspace.\nThis fails if the Workspace feature isn't enabled on the target organization's tariff plan.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "user",
                "invitation"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"<string>\",\n  \"name\": \"<string>\",\n  \"organisation\": {\n    \"id\": \"<integer>\"\n  },\n  \"roles\": [\n    {\n      \"id\": \"<integer>\"\n    },\n    {\n      \"id\": \"<integer>\"\n    }\n  ]\n}",
